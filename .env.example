# ==========================================
# The Lenny Growth Assistant - Environment Configuration
# ==========================================

# Active LLM Provider: "ollama" | "mock" | "openai" | "anthropic"
# - "ollama": Mandatory default for local evaluation. Requires Ollama running locally.
# - "mock": High-quality zero-dependency extractive synthesis directly from transcripts (for instant laptop testing).
# - "openai": Requires OPENAI_API_KEY. Uses gpt-4o-mini.
# - "anthropic": Requires ANTHROPIC_API_KEY. Uses claude-3-5-sonnet.
LLM_PROVIDER=mock

# Ollama Settings (Default local configuration)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=45.0

# Cloud Provider API Keys (Optional alternate paths)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Database Configuration
# Primary: PostgreSQL with pgvector (in Docker Compose)
DATABASE_URL=postgresql://lenny:growth@localhost:5432/lenny_growth
# Note: If PostgreSQL is offline, backend automatically falls back to SQLite at data/lenny_growth.db

# RAG & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.30
TOP_K_CHUNKS=4
